# Только имена. Реальные значения хранить в .env (в .gitignore) и в Vercel. См. docs/api-contract.md, раздел 5.

# Postgres (Neon): pooled для приложения, unpooled для миграций (npm run db:migrate)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Вход: ADMIN_PASSWORD >= 12 символов; SESSION_SECRET и CRON_SECRET >= 32 символов (openssl rand -base64 48)
ADMIN_PASSWORD=
SESSION_SECRET=
CRON_SECRET=

# PSN
PSN_NPSSO=
PSN_TARGET_ONLINE_ID=
# AES-256-GCM для токенов в psn_auth: 32 байта в base64 (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# Необязательные (значения по умолчанию в скобках)
PSN_REQUEST_DELAY_MS=300
SYNC_TIME_BUDGET_MS=50000 # максимум 55000
# Доверенный origin для самовызова синка (прод: https://<ваш-домен>). Локально и на Vercel определяется сам, можно не задавать
SYNC_ORIGIN=

# Предупреждения о протухании NPSSO в Telegram (необязательно; без обеих переменных ничего не отправляется). См. контракт 15.4
# Бот: @BotFather -> /newbot; chat id: написать боту и открыть https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Фаза 29 «Сводка в Telegram» (контракт F29.8). Секрет webhook: 16-256 символов A-Za-z0-9_-, тот же передать в setWebhook (secret_token).
TELEGRAM_WEBHOOK_SECRET=
# Ник бота без @ (необязательно, для ссылки «Открыть бота»)
TELEGRAM_BOT_USERNAME=

# Фаза 12: поиск релизов для роадмапа в каталоге RAWG (необязательно; без ключа поиск отвечает 503 catalog_unavailable, ручной ввод работает).
# Бесплатный ключ: https://rawg.io/apidocs. Только на сервере. См. контракт 17.9
RAWG_API_KEY=

# Фаза 13 «Подскажи»: бесплатный LLM переформулирует готовые факты скоринга в 1-2 фразы (необязательно; без ключа работают шаблоны, meta.llm = "disabled").
# Провайдер: gemini (Google AI Studio, free tier) или groq (free tier). Ключ только на сервере, не логируется. См. контракт 18.2
LLM_PROVIDER=
LLM_API_KEY=
# Потолок реальных вызовов в сутки по МСК (по умолчанию 60, 0..200, 0 = выключено)
LLM_DAILY_LIMIT=60
# Фаза 20.4: LLM_DAILY_LIMIT — общий потолок в сутки по сумме всех пользователей (ставьте не меньше числа_пользователей x 12; если меньше, cron при старте обхода пишет предупреждение в лог);
# LLM_USER_DAILY_LIMIT — потолок вызовов одного пользователя в сутки (по умолчанию 12)
# LLM_USER_DAILY_LIMIT=12
# Модель провайдера (необязательно; по умолчанию gemini-2.5-flash-lite / llama-3.1-8b-instant)
LLM_MODEL=

# Публичный адрес сайта для ссылок на игры в сообщениях Telegram: https://<домен> (необязательно; без него ссылок нет). См. контракт 15.4
APP_ORIGIN=

# Фаза 20 (контракт 22.8): вход через Google OAuth. Redirect URI в консоли Google: ${APP_ORIGIN}/api/auth/google/callback
# APP_ORIGIN (выше) с Фазы 20 обязателен: https://<домен>. Секрет только на сервере, не логируется.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ВНИМАНИЕ, порядок выкладки Фазы 20.2: миграция 0013 -> npm run db:bootstrap-owner -> деплой кода. Деплой до bootstrap
# заблокирует вход всем (owner нет в allowed_users). Скрипт падает, если owner.id <> 1 (на него завязан cookie v:1).
# APP_ORIGIN должен быть ЕДИНСТВЕННЫМ боевым доменом: вход с www/preview-домена даст oauth_failed (cookie не доедет до callback).
# Email владельца (Google-аккаунт) для npm run db:bootstrap-owner; PSN_TARGET_ONLINE_ID копируется в owner
OWNER_EMAIL=
# 1 разрешает добавлять member (ставить только после миграции 0015 и QA изоляции, контракт 22.7 шаг 8)
MULTIUSER_ENABLED=0
# Потолок invited + active профилей (Фаза 41: считаются профили, 1..100)
MAX_USERS=10
# Потолок активных профилей PSN на один вход (Фаза 41, 1..5)
MAX_PROFILES_PER_LOGIN=3
# public | friend (план Б, контракт 22.2)
PSN_NEW_USER_MODE=public

# Хвост 20.5 (контракт 24): лимиты запросов к RAWG и HLTB в сутки по МСК. Пользовательский и общий (сумма пользователей). Необязательно.
# RAWG бесплатно: 20000 запросов в месяц (около 650 в сутки). Общий 0 = провайдер выключен. Нужна миграция 0017 (без неё лимиты считаются в памяти процесса).
# RAWG_USER_DAILY_LIMIT=60
# RAWG_DAILY_LIMIT=300
# HLTB_USER_DAILY_LIMIT=300
# HLTB_DAILY_LIMIT=1000
